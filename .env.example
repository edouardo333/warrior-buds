# Bud Guardian V10 — external AI provider configuration.
# See src/lib/bud-guardian/ai-provider.ts and
# src/app/api/bud-guardian/chat/route.ts.
#
# Copy this file to .env.local (gitignored) and fill in real values there —
# never commit a real API key.

# Set to "external" to let Bud Guardian's open-ended replies come from a
# real hosted model (via the server route below) instead of the fully
# local keyword/FAQ engine. Any other value, or leaving this unset, keeps
# the default: LocalHeuristicProvider, which never makes a network call.
# This is exposed to the browser (NEXT_PUBLIC_) because the client needs it
# to choose a provider — it never carries a secret.
NEXT_PUBLIC_GUARDIAN_AI_PROVIDER=local

# Server-only secret — the API key app/api/bud-guardian/chat/route.ts uses
# to call the model. NEVER prefix this with NEXT_PUBLIC_: it must stay out
# of the browser bundle. Required whenever
# NEXT_PUBLIC_GUARDIAN_AI_PROVIDER=external; if it's missing (or the request
# fails/times out), Bud Guardian automatically falls back to the local
# provider for that turn — see ai-provider.ts's FallbackAIProvider.
GUARDIAN_AI_API_KEY=

# Optional — defaults to claude-sonnet-5 if unset.
GUARDIAN_AI_MODEL=claude-sonnet-5
